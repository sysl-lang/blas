module sh.sysl.blas

/** The routines over views: every one checks the operands' extents against each other first, and
 * only then hands BLAS the pointers, extents, increments and leading dimensions the views carry. A
 * view's own range was checked when it was made (`VectorView.of`, `MatrixView.strided`, …), so a
 * call here never gives BLAS a stride or a leading dimension it would reject.
 *
 * An output must not share elements with an input, which is BLAS's rule; it is not checked, since
 * two blocks of one matrix interleave in memory without sharing an element.
 */

private dims[T](op: Op, a: MatrixView[T]) -> (usize, usize) = if op == NoTrans then (a.rows, a.cols) else (a.cols, a.rows)

/** `Σ xᵢ·yᵢ`, the product nex's `x @ y` is — unconjugated for a complex element (`?dotu_sub`). */
dot[T: Element](x: VectorView[T], y: VectorView[T]) -> Result[T, BlasError]
    if x.len != y.len then return Err(ShapeMismatch)

    Ok(T.dotu(i32(x.len), x.ptr, i32(x.inc), y.ptr, i32(y.inc)))

/** `Σ conj(xᵢ)·yᵢ` (`?dotc_sub`); for a real element the same as `dot`. */
dotc[T: Element](x: VectorView[T], y: VectorView[T]) -> Result[T, BlasError]
    if x.len != y.len then return Err(ShapeMismatch)

    Ok(T.dotc(i32(x.len), x.ptr, i32(x.inc), y.ptr, i32(y.inc)))

/** `y ← α·x + y`. */
axpy[T: Element](alpha: T, x: VectorView[T], y: VectorView[T]) -> Result[unit, BlasError]
    if x.len != y.len then return Err(ShapeMismatch)

    T.axpy(i32(x.len), alpha, x.ptr, i32(x.inc), y.ptr, i32(y.inc))
    Ok(())

/** `x ← α·x`.
 *
 * **A negative increment scales nothing.** The reference BLAS defines `?scal`, `?nrm2` and `?asum`
 * only for a positive increment and answers a quick return otherwise; the order a vector runs in
 * does not change any of the three, so these pass `|inc|`, and a reversed view is scaled, measured and
 * summed exactly as the forward one over the same storage.
 */
scal[T: Element](alpha: T, x: VectorView[T]) = T.scal(i32(x.len), alpha, x.ptr, unit_inc(x.inc))

/** `‖x‖₂`, computed without overflow by the library's scaling — at the element's real width. */
nrm2[T: Element](x: VectorView[T]) -> T::Real = T.nrm2(i32(x.len), x.ptr, unit_inc(x.inc))

/** `Σ |xᵢ|` for a real element, `Σ |re xᵢ| + |im xᵢ|` for a complex one (BLAS's `asum`, not the
 * modulus) — at the element's real width.
 */
asum[T: Element](x: VectorView[T]) -> T::Real = T.asum(i32(x.len), x.ptr, unit_inc(x.inc))

private unit_inc(inc: int) -> i32 = i32(if inc < 0 then -inc else inc)

/** `y ← α·op(A)·x + β·y`. `op(A)` is `m` × `n`: `x` must have `n` elements and `y` `m`. */
gemv[T: Element](op: Op, alpha: T, a: MatrixView[T], x: VectorView[T], beta: T, y: VectorView[T]) -> Result[unit, BlasError]
    val (m, n) = dims(op, a)

    if x.len != n || y.len != m then return Err(ShapeMismatch)

    T.gemv(flag(op), i32(a.rows), i32(a.cols), alpha, a.ptr, i32(a.ld), x.ptr, i32(x.inc), beta, y.ptr, i32(y.inc))
    Ok(())

/** `C ← α·op(A)·op(B) + β·C`. `op(A)` is `m` × `k`, `op(B)` is `k` × `n`, and `C` is `m` × `n`. */
gemm[T: Element](op_a: Op, op_b: Op, alpha: T, a: MatrixView[T], b: MatrixView[T], beta: T, cm: MatrixView[T]) -> Result[unit, BlasError]
    val (m, k) = dims(op_a, a)
    val (kb, n) = dims(op_b, b)

    if k != kb || cm.rows != m || cm.cols != n then return Err(ShapeMismatch)

    T.gemm(flag(op_a), flag(op_b), i32(m), i32(n), i32(k), alpha, a.ptr, i32(a.ld), b.ptr, i32(b.ld), beta, cm.ptr, i32(cm.ld))
    Ok(())
